#!/bin/sh
set -e

override=/var/www/html/config/packages/prod/override

if [ -n "$SHOPWARE_CONFIG" ]; then
    printf '%s\n' "$SHOPWARE_CONFIG" > "$override/env.yaml"
fi

# The container cache built into the image does not know the config in the override directory.
# Remove it, so the first command or request builds a new one with that config.
if [ -n "$(ls -A "$override" 2>/dev/null)" ]; then
    rm -rf /var/www/html/var/cache/prod_*
fi

php /usr/local/share/shopware/deploy.php

exec docker-php-entrypoint "$@"
