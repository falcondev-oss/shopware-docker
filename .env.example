# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32
APP_URL=https://shop.example.com
APP_SECRET=
INSTANCE_ID=
DB_PASSWORD=
# Only used for the first installation
INSTALL_ADMIN_PASSWORD=
INSTALL_ADMIN_EMAIL=
#INSTALL_LOCALE=de-DE
#INSTALL_CURRENCY=EUR

#MAILER_DSN=smtp://user:pass@smtp.example.com:587

# Address the reverse proxy connects to
#HTTP_BIND=127.0.0.1:8000

# Tuning
#WORKER_REPLICAS=2
#DB_BUFFER_POOL_SIZE=1G
#DB_MAX_CONNECTIONS=500
#CACHE_MAXMEMORY=1gb
#PHP_MEMORY_LIMIT=512m
#PHP_MAX_UPLOAD_SIZE=128m
#LOG_LEVEL=error

# Build: Composer auth JSON, e.g. {"bearer":{"packages.shopware.com":"<token>"}}
#COMPOSER_AUTH=
